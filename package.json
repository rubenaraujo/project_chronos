  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/rubenaraujo/project_chronos/issues"
  },
  "homepage": "https://github.com/rubenaraujo/project_chronos#readme",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
